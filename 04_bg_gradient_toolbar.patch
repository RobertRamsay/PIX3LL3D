diff --git a/objects/obj_editor/Step_0.gml b/objects/obj_editor/Step_0.gml
index b6b80b0..9b4d80c 100644
--- a/objects/obj_editor/Step_0.gml
+++ b/objects/obj_editor/Step_0.gml
@@ -11,6 +11,9 @@ if (pe_open)
     exit;
 }
 
+// Background gradient swatch / RGB popup (can claim the mouse and Esc)
