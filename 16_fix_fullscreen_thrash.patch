     {
-        window_set_fullscreen(false);
+        win_cooldown -= 1;
+    }
 
-        // Restore the last windowed size, kept inside the display
-        var _w = win_last_w;
-        var _h = win_last_h;
-        _w = clamp(_w, 640, max(display_get_width() - 80, 640));
-        _h = clamp(_h, 480, max(display_get_height() - 120, 480));
+    if (win_settle <= 0)
+    {
+        return;
+    }
 
-        window_set_size(_w, _h);
-        window_center();
+    win_settle -= 1;
+
+    // Bailed back to fullscreen in the meantime: drop the pending resize
+    if (window_get_fullscreen())
+    {
+        win_settle = 0;
+        return;
     }
-    else
+
+    // One operation per frame, well clear of the swap chain rebuild
+    if (win_settle == 4)
     {
-        // Remember where we were so coming back out lands the same way
-        win_last_w = window_get_width();
-        win_last_h = window_get_height();
-        window_set_fullscreen(true);
+        var _w = clamp(win_last_w, 640, max(display_get_width() - 80, 640));
+        var _h = clamp(win_last_h, 480, max(display_get_height() - 120, 480));
+        window_set_size(_w, _h);
